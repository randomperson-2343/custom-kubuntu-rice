{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/matrix-logo.txt",
    "color": { "1": "{{FG_SGR}}", "2": "{{HEAD_SGR}}", "3": "{{DIM_SGR}}" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "{{DIM_SGR}}", "title": "{{FG_SGR}}", "output": "{{FG_SGR}}" },
    "key": { "width": 10 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "────────────────────────────" },
    { "type": "os", "key": "os" },
    { "type": "host", "key": "host" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "de", "key": "desktop" },
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "battery", "key": "battery" },
    "break",
    { "type": "custom", "format": "wake up, neo..." }
  ]
}
