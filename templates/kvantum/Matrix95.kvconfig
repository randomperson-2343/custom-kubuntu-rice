# Matrix95 ({{NAME}}): Windows 95 bevels in Matrix colours, for Kvantum.
# Template: colours are double-brace placeholders filled by lib/common.sh render.
# Companion file: Matrix95-{{NAME}}.svg (generated by gen-matrix95-svg.py).

[%General]
author=matrix-rice
comment=Windows 95 style widgets in the Matrix {{NAME}} palette
respect_DE=true
x11drag=none
alt_mnemonic=true
inline_spin_indicators=false
vertical_spin_indicators=false
spin_button_width=16
combo_as_lineedit=false
combo_menu=false
combo_focus_rect=true
square_combo_button=false
left_tabs=true
center_doc_tabs=false
attach_active_tab=true
embedded_tabs=false
joined_inactive_tabs=false
active_tab_overlap=0
no_inactive_tab_expansion=true
bold_active_tab=false
tab_button_extra_margin=2
group_toolbar_buttons=false
toolbar_item_spacing=1
toolbar_interior_spacing=2
toolbar_separator_thickness=6
center_toolbar_handle=false
slim_toolbars=true
spread_progressbar=false
progressbar_thickness=1.3font
spread_header=false
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
spread_menuitems=false
composite=false
scrollable_menu=true
menu_separator_height=6
submenu_overlap=0
submenu_delay=250
animate_states=false
no_inactiveness=false
splitter_width=6
scroll_width=16
scroll_min_extent=24
scroll_arrows=true
scrollbar_in_view=false
transient_scrollbar=false
tree_branch_line=false
groupbox_top_label=false
slider_width=6
slider_handle_width=21
slider_handle_length=11
check_size=13
layout_spacing=4
layout_margin=6
fill_rubberband=false
remove_extra_frames=false

[GeneralColors]
window.color={{FACE}}
inactive.window.color={{FACE}}
base.color={{BG}}
inactive.base.color={{BG}}
alt.base.color={{SURFACE}}
inactive.alt.base.color={{SURFACE}}
button.color={{FACE}}
light.color={{HILITE}}
mid.light.color={{LIGHT}}
dark.color={{SHADOW}}
mid.color={{FAINT}}
shadow.color={{DKSHADOW}}
highlight.color={{TITLE}}
inactive.highlight.color={{TITLE_INACTIVE}}
tooltip.base.color={{BG}}
text.color={{FG}}
inactive.text.color={{FG}}
window.text.color={{FG}}
inactive.window.text.color={{FG}}
button.text.color={{FG}}
disabled.text.color={{DIM}}
tooltip.text.color={{HEAD}}
highlight.text.color={{HEAD}}
inactive.highlight.text.color={{TITLE_INACTIVE_TEXT}}
link.color={{HEAD}}
link.visited.color={{DIM}}
progress.indicator.text.color={{BG}}
progress.inactive.indicator.text.color={{BG}}

[Hacks]
respect_darkness=true
transparent_ktitle_label=false
transparent_menutitle=false
kinetic_scrolling=false
disabled_icon_opacity=60

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=button
indicator.size=9
indicator.element=arrow
min_height=24
text.normal.color={{FG}}
text.focus.color={{HEAD}}
text.press.color={{HEAD}}
text.toggle.color={{HEAD}}
text.shadow=false
text.margin=1
text.iconspacing=4
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tool
interior.element=tool
interior.x.patternsize=2
interior.y.patternsize=2
min_height=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=dock
min_height=0
text.focus.color={{HEAD}}
text.bold=true
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.element=spin
interior.element=spin
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.size=9
indicator.element=arrow
min_height=0

[RadioButton]
inherits=PanelButtonCommand
interior.element=radio
frame=false
min_height=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[CheckBox]
inherits=PanelButtonCommand
interior.element=checkbox
frame=false
min_height=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[Focus]
inherits=PanelButtonCommand
interior=false
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=2

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=field
interior.element=field
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=field
interior.element=field
min_height=24
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down
min_height=0

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand
min_height=0

[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
indicator.element=tab
frame.top=4
frame.bottom=1
frame.left=2
frame.right=2
min_height=0
text.margin.top=2
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
text.normal.color={{FG}}
text.focus.color={{HEAD}}
text.press.color={{HEAD}}
text.toggle.color={{HEAD}}

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false
text.shadow=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=tree
indicator.size=9
min_height=0

[HeaderSection]
inherits=PanelButtonCommand
indicator.element=arrow
min_height=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[SizeGrip]
indicator.element=sizegrip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
frame.element=toolbar
interior.element=toolbar
frame.top=1
frame.bottom=1
frame.left=0
frame.right=0
min_height=0
text.normal.color={{FG}}
text.focus.color={{HEAD}}

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
min_height=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
min_height=0

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
min_height=0
text.normal.color={{FG}}
text.focus.color={{BG}}
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame=false
interior.element=progress-pattern
interior.x.patternsize=10
interior.y.patternsize=0
min_height=0

[ItemView]
inherits=PanelButtonCommand
text.margin=0
frame=false
interior=true
interior.element=itemview
min_height=0
text.normal.color={{FG}}
text.focus.color={{FG}}
text.press.color={{HEAD}}
text.toggle.color={{HEAD}}

[Splitter]
inherits=PanelButtonCommand
frame=false
interior.element=splitter
frame.element=splitter
indicator.element=splitter-grip
indicator.size=4
min_height=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=sbarrow
indicator.size=16
min_height=0

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=grip
indicator.size=4
min_height=0

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=sbgroove
interior.x.patternsize=2
interior.y.patternsize=2
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
min_height=0

[MenuItem]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=menuitem
indicator.element=menuitem
min_height=20
text.normal.color={{FG}}
text.focus.color={{HEAD}}
text.press.color={{HEAD}}
text.toggle.color={{HEAD}}
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4

[MenuBarItem]
inherits=PanelButtonCommand
frame=false
interior=true
interior.element=menubaritem
frame.element=menubaritem
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
min_height=0
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6

[MenuBar]
inherits=PanelButtonCommand
frame=false
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
interior=true
interior.element=menubar
min_height=0
text.normal.color={{FG}}
text.focus.color={{HEAD}}
text.press.color={{HEAD}}
text.toggle.color={{HEAD}}

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=14
indicator.element=mdi
min_height=0
text.normal.color={{TITLE_INACTIVE_TEXT}}
text.focus.color={{HEAD}}
text.bold=true
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[ComboBox]
inherits=PanelButtonCommand
frame.element=combo
interior.element=combo
indicator.element=combo-arrow
indicator.size=20
min_height=24
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3

[Menu]
inherits=PanelButtonCommand
frame=true
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
frame.element=menu
interior=true
interior.element=menu
min_height=0

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=false
interior.element=group
text.shadow=false
text.margin=0
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color={{FG}}

[ToolTip]
inherits=GenericFrame
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.shadow=false
text.margin=0

[Window]
interior=false

[Dialog]
interior=false
